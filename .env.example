NEXT_PUBLIC_SITE_URL=https://www.assigners.com
SALES_EMAIL=sales@assigners.com
INFO_EMAIL=info@assigners.com
COMPLIANCE_EMAIL=compliance@assigners.com

# Where "Talk to Sales" form submissions are emailed. Defaults to info@assigners.com if unset.
FORM_NOTIFICATION_EMAIL=info@assigners.com

# Required to actually send that email. Sign up at https://resend.com, verify the
# assigners.com sending domain, then paste the API key here. Without this set, submissions
# are still accepted and validated but are only logged to the server console, not delivered.
RESEND_API_KEY=

# Must be an address on a domain verified in Resend, e.g. "Assigners <leads@assigners.com>".
# Until assigners.com is verified in Resend, leave unset to use Resend's shared test sender
# (onboarding@resend.dev) — fine for testing, but should be switched before relying on this in production.
RESEND_FROM_EMAIL=

CRM_WEBHOOK_URL=

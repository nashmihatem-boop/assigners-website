NEXT_PUBLIC_SITE_URL=https://www.assigners.com
SALES_EMAIL=sales@assigners.com
INFO_EMAIL=info@assigners.com
COMPLIANCE_EMAIL=compliance@assigners.com

# Where "Talk to Sales" form submissions are emailed. Defaults to info@assigners.com if unset.
# Comma-separate multiple addresses, e.g. sales@assigners.com,you@yourdomain.com
FORM_NOTIFICATION_EMAIL=sales@assigners.com

# Where consumer leads (Learning Center forms) are emailed. Defaults to info@assigners.com if unset.
# Comma-separate multiple addresses.
CONSUMER_LEAD_EMAIL=sales@assigners.com

# Required to actually send that email. Sign up at https://resend.com, verify the
# assigners.com sending domain, then paste the API key here. Without this set, submissions
# are still accepted and validated but are only logged to the server console, not delivered.
RESEND_API_KEY=

# Must be an address on a domain verified in Resend. assigners.com is verified as of
# 2026-07-28, so this can point at a real mailbox. Leave unset to fall back to Resend's
# shared test sender (onboarding@resend.dev) instead.
RESEND_FROM_EMAIL=Assigners <sales@assigners.com>

CRM_WEBHOOK_URL=
